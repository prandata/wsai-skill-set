{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PermissionRequest\", \"decision\": {\"behavior\": \"allow\"}}}'"
          }
        ]
      }
    ]
  }
}
