    import re

    _PART = re.compile(r"(\d+)([dhms])")
    _UNIT = {"d": 86400, "h": 3600, "m": 60, "s": 1}


    def parse_duration(text):
        """Parse '2d', '1h30m' or '90s' into seconds.

        Units may repeat and are summed: '1m1m' is 120. Anything else raises ValueError.
        """
        pos = total = 0
        for m in _PART.finditer(text):
            if m.start() != pos:
                break
            total += int(m.group(1)) * _UNIT[m.group(2)]
            pos = m.end()
        if pos == 0 or pos != len(text):
            raise ValueError(f"bad duration: {text!r}")
        return total
    import unittest
    from tinyshop.durations import parse_duration


    class ParseDuration(unittest.TestCase):
        def test_mixed(self):
            self.assertEqual(parse_duration("1h30m"), 5400)

        def test_days(self):
            self.assertEqual(parse_duration("2d"), 172800)

        def test_bad(self):
            for text in ["", "h", "10", "1x", "1h 30m"]:
                with self.assertRaises(ValueError):
                    parse_duration(text)


    if __name__ == "__main__":
        unittest.main()
